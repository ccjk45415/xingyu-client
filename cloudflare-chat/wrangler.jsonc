{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xingyu-chat",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/health",
      "/v1/*",
      "/ws",
      "/updates/*",
      "/dm/*",
      "/announcements",
      "/announcements/*",
      "/media/*",
      "/ai/*",
      "/discovery",
      "/discovery/*",
      "/client-config",
      "/client-config/*",
      "/checkin/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT",
        "class_name": "ChatHub"
      },
      {
        "name": "DM",
        "class_name": "DmHub"
      },
      {
        "name": "ANNOUNCEMENTS",
        "class_name": "AnnouncementHub"
      },
      {
        "name": "VERIFIED_CHAT",
        "class_name": "VerifiedChatHub"
      },
      {
        "name": "AI_DRAFTS",
        "class_name": "AiDraftHub"
      },
      {
        "name": "CHECKIN",
        "class_name": "CheckinHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChatHub"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "DmHub"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "AnnouncementHub"
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": [
        "VerifiedChatHub"
      ]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": [
        "AiDraftHub"
      ]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": [
        "CheckinHub"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "ai": {
    "binding": "AI"
  }
}
